SELECT Cust_Master.Cust_name,
       Product.Product_name
FROM Cust_Master
INNER JOIN Orders
ON Cust_Master.Cust_no = Orders.Cust_no
INNER JOIN Product
ON Orders.Order_no = Product.Order_no;


CREATE VIEW View1 AS
SELECT Cust_Master.Cust_name,
       Product.Product_name
FROM Cust_Master
INNER JOIN Orders
ON Cust_Master.Cust_no = Orders.Cust_no
INNER JOIN Product
ON Orders.Order_no = Product.Order_no;


SELECT Cust_Master.Cust_name,
       Product.Product_name,
       Orders.Qty_Ordered
FROM Cust_Master
INNER JOIN Orders
ON Cust_Master.Cust_no = Orders.Cust_no
INNER JOIN Product
ON Orders.Order_no = Product.Order_no;


SELECT Cust_Master.Cust_name,
       Orders.Order_no
FROM Cust_Master
INNER JOIN Orders
ON Cust_Master.Cust_no = Orders.Cust_no;


SELECT Cust_Master.Cust_name,
       Orders.Order_no
FROM Cust_Master
LEFT JOIN Orders
ON Cust_Master.Cust_no = Orders.Cust_no;


SELECT Cust_Master.Cust_name,
       Orders.Order_no
FROM Cust_Master
RIGHT JOIN Orders
ON Cust_Master.Cust_no = Orders.Cust_no;


SELECT Cust_Master.Cust_name,
       Product.Product_name
FROM Cust_Master
CROSS JOIN Product;
