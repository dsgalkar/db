SELECT Companies.name,
       Companies.cost,
       Orders.domain,
       Orders.quantity
FROM Companies
INNER JOIN Orders
ON Companies.comp_id = Orders.comp_id;


SELECT Companies.name,
       Companies.cost,
       Orders.domain,
       Orders.quantity
FROM Companies
LEFT JOIN Orders
ON Companies.comp_id = Orders.comp_id;


SELECT Companies.name,
       Companies.cost,
       Orders.domain,
       Orders.quantity
FROM Companies
RIGHT JOIN Orders
ON Companies.comp_id = Orders.comp_id;


SELECT Companies.name,
       Companies.cost,
       Orders.domain,
       Orders.quantity
FROM Companies
RIGHT JOIN Orders
ON Companies.comp_id = Orders.comp_id;


CREATE VIEW View1 AS
SELECT Companies.name,
       Orders.quantity
FROM Companies
INNER JOIN Orders
ON Companies.comp_id = Orders.comp_id;


CREATE VIEW View2 AS
SELECT comp_id, name
FROM Companies;


